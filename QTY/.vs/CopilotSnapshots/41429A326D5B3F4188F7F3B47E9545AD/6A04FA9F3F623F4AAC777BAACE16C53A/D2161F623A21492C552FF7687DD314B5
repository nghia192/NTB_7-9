        // POST: /DKCa/UpdateShiftName
        [HttpPost]
        public JsonResult UpdateShiftName(UpdateShiftNameRequest req)
        {
            try
            {
                using (var conn = SqlHelper.GetConnection())
                {
                    // Call stored procedure to update name and cascade
                    var ds = SqlHelper.ExecuteDataset(conn, "SP_CaLamViec_SuaTenKhoang", req.CaLV, req.TimeShiftID, req.NewName);
                    var details = new List<ShiftDetailModel>();
                    if (ds != null && ds.Tables.Count > 0)
                    {
                        foreach (DataRow r in ds.Tables[0].Rows)
                        {
                            var item = new ShiftDetailModel();
                            item.TimeShiftID = r.Field<string>("TimeShiftID");
                            item.Name = r.Field<string>("Name");
                            var tl = r["TimeLine"];
                            if (tl != DBNull.Value)
                                item.TimeLine = ((TimeSpan)tl).ToString(@"hh\:mm\:ss");
                            item.Minutes = r.Field<int>("Minutes");
                            details.Add(item);
                        }
                    }
                    return Json(new { success = true, details = details });
                }
            }
            catch (Exception ex)
            {
                return Json(new { success = false, error = ex.Message });
            }
        }

        // POST: /DKCa/DeleteShiftDetail
        [HttpPost]
        public JsonResult DeleteShiftDetail(DeleteShiftDetailRequest req)
        {
            try
            {
                using (var conn = SqlHelper.GetConnection())
                {
                    // Build safe table name
                    var tableName = "TimeShift_Ca" + req.caLV;
                    // Delete row then renumber TimeShiftID
                    var sql = $@"
                    DELETE FROM dbo.{tableName} WHERE TimeShiftID = @p_id;
                    ;WITH Numbered AS (
                        SELECT TimeShiftID, ROW_NUMBER() OVER (ORDER BY TimeLine) AS RN
                        FROM dbo.{tableName}
                    )
                    UPDATE t
                    SET t.TimeShiftID = RIGHT('000' + CAST(n.RN AS VARCHAR(3)), 3)
                    FROM dbo.{tableName} t
                    JOIN Numbered n ON n.TimeShiftID = t.TimeShiftID;
                    SELECT TimeShiftID, Name, TimeLine, Minutes FROM dbo.{tableName} ORDER BY TimeLine;
                    ";
                    // Escape single quotes in id param
                    var id = req.timeShiftID.Replace("'", "''");
                    // Execute as command text; use sp_executesql with parameterization would be better but SqlHelper helper is limited here
                    sql = sql.Replace("@p_id", "'" + id + "'");
                    var ds = SqlHelper.ExecuteDataset(conn, CommandType.Text, sql);
                    var details = new List<ShiftDetailModel>();
                    if (ds != null && ds.Tables.Count > 0)
                    {
                        foreach (DataRow r in ds.Tables[0].Rows)
                        {
                            var item = new ShiftDetailModel();
                            item.TimeShiftID = r.Field<string>("TimeShiftID");
                            item.Name = r.Field<string>("Name");
                            var tl = r["TimeLine"];
                            if (tl != DBNull.Value)
                                item.TimeLine = ((TimeSpan)tl).ToString(@"hh\:mm\:ss");
                            item.Minutes = r.Field<int>("Minutes");
                            details.Add(item);
                        }
                    }
                    return Json(new { success = true, details = details });
                }
            }
            catch (Exception ex)
            {
                return Json(new { success = false, error = ex.Message });
            }
        }
        // GET: /DKCa/GetShifts
        public JsonResult GetShifts()
        {
            try
            {
                using (var conn = SqlHelper.GetConnection())
                {
                    var ds = SqlHelper.ExecuteDataset(conn, CommandType.Text, "SELECT CaLV, TGBatDau, TGKetThuc FROM dbo.DM_CaLamViec ORDER BY CaLV");
                    var list = new List<ShiftModel>();
                    if (ds != null && ds.Tables.Count > 0)
                    {
                        foreach (DataRow r in ds.Tables[0].Rows)
                        {
                            var item = new ShiftModel();
                            item.CaLV = r.Field<int>("CaLV");
                            var tb = r["TGBatDau"];
                            var te = r["TGKetThuc"];
                            if (tb != DBNull.Value)
                                item.TGBatDau = ((TimeSpan)tb).ToString(@"hh\:mm");
                            if (te != DBNull.Value)
                                item.TGKetThuc = ((TimeSpan)te).ToString(@"hh\:mm");
                            list.Add(item);
                        }
                    }
                    return Json(list, JsonRequestBehavior.AllowGet);
                }
            }
            catch (Exception ex)
            {
                return Json(new { error = ex.Message }, JsonRequestBehavior.AllowGet);
            }
        }

