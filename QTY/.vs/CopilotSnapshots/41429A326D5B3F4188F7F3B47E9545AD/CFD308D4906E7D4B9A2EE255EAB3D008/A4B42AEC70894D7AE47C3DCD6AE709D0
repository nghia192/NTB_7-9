$(function(){
    var shifts = [];
    var details = [];

    // local confirm modal that prefers SweetAlert2, then shared showDeleteConfirm,
    // then DevExtreme dialog, and finally falls back to native confirm
    function confirmModal(message, title) {
        return new Promise(function (resolve) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'warning',
                    title: title || 'Xác nhận',
                    text: message || '',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa',
                    cancelButtonText: 'Hủy',
                    confirmButtonColor: '#dc3545',
                    reverseButtons: true
                }).then(function (res) { resolve(!!res.isConfirmed); });
                return;
            }

    // show a modal alert (prefers SweetAlert2, falls back to DevExtreme notify or native alert)
    function showModalAlert(message, type, title) {
        type = (type || 'info');
        title = title || (type === 'error' ? 'Lỗi' : (type === 'warning' ? 'Cảnh báo' : 'Thông báo'));
        if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: type === 'error' ? 'error' : (type === 'warning' ? 'warning' : 'info'), title: title, text: message });
            return;
        }
        try {
            if (DevExpress && DevExpress.ui && DevExpress.ui.notify) {
                DevExpress.ui.notify(message, type === 'error' ? 'error' : (type === 'warning' ? 'warning' : 'info'), 4000);
                return;
            }
        } catch (ex) { }
        alert((title ? title + ': ' : '') + message);
    }
            if (typeof showDeleteConfirm === 'function') {
                showDeleteConfirm(message, title).then(function (r) { resolve(!!r); });
                return;
            }
            try {
                if (DevExpress && DevExpress.ui && DevExpress.ui.dialog && typeof DevExpress.ui.dialog.confirm === 'function') {
                    var r = DevExpress.ui.dialog.confirm(message, title || 'Xác nhận');
                    // DevExpress dialog.confirm returns a Promise-like in some versions
                    if (r && typeof r.then === 'function') {
                        r.then(function (val) { resolve(!!val); });
                    } else {
                        resolve(!!r);
                    }
                    return;
                }
            } catch (ex) { }
            // fallback
            resolve(confirm(message));
        });
    }

    var gridShifts = $("#gridShifts").dxDataGrid({
        dataSource: shifts,
        keyExpr: 'CaLV',
        showBorders: true,
        height: 360,
        allowColumnResizing: true,
        columnResizingMode: 'widget',
        columnAutoWidth: false,
        scrolling: { mode: 'virtual' },
        pager: { visible: false },
        filterRow: { visible: true },
        searchPanel: { visible: true, width: 240, placeholder: 'Tìm ca...' },
        editing: {
            mode: 'cell',
            allowUpdating: true,
            allowDeleting: false
        },
        columns: [
            { caption: 'STT', dataField: 'STT', width: 50, allowFiltering:false, allowEditing: false, alignment: 'center' },
            { caption: 'CaLV', dataField: 'CaLV', width: 80, alignment: 'center', allowEditing: false },
            { caption: 'Thời gian bắt đầu', dataField: 'TGBatDau', dataType: 'string', width: 200, alignment: 'center' },
            { caption: 'Thời gian kết thúc', dataField: 'TGKetThuc', dataType: 'string', width: 200, alignment: 'center' },
            { caption: '', width: 80, allowFiltering: false, allowSorting: false, allowEditing: false, cellTemplate: function(container, options){
                    var btn = $('<button class="btn btn-sm btn-outline-danger">Xóa</button>');
                    btn.on('click', function(){
                        // Use shared SweetAlert2-based confirm from ResourceMananger if available,
                        // fallback to native confirm otherwise.
                        var message = 'Xóa ca ' + options.data.CaLV + '?';
                        if (typeof showDeleteConfirm === 'function') {
                            showDeleteConfirm(message, 'Xóa ca').then(function(confirmed){
                                if(!confirmed) return;
                                doDelete();
                            });
                        } else {
                            if(!confirm(message)) return;
                            doDelete();
                        }

                        function doDelete(){
                            $.ajax({
                                url: '/DKCa/DeleteShift',
                                method: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify({ CaLV: options.data.CaLV }),
                                success: function(resp){
                                    if(resp && resp.success === false){
                                        showModalAlert(resp.error || 'Không thể xóa ca', 'error', 'Lỗi');
                                        return;
                                    }
                                    loadShifts();
                                    if(selectedCaLV === options.data.CaLV){
                                        details = [];
                                        gridDetails.option('dataSource', details);
                                        selectedCaLV = null;
                                    }
                                    showModalAlert('Đã xóa', 'info', 'Thành công');
                                },
                                error: function(){ showModalAlert('Lỗi khi xóa ca.', 'error', 'Lỗi'); }
                            });
                        }
                    });
                    $(container).append(btn);
                }
            },
            { caption: '', width: 80, allowFiltering: false, allowSorting: false, allowEditing: false, cellTemplate: function(container, options){
                    var btn = $('<button class="btn btn-sm btn-primary">Chọn</button>');
                    btn.on('click', function(){
                        selectedCaLV = options.data.CaLV;
                        var inst = $("#gridShifts").dxDataGrid('instance');
                        try{ inst.selectRows([options.data.CaLV], false); }catch(ex){}
                        loadShiftDetails(options.data.CaLV);
                    });
                    $(container).append(btn);
                }
            }
        ],
        onRowClick: function(e){
            var caLV = e.data.CaLV;
            selectedCaLV = caLV;
            loadShiftDetails(caLV);
        },
        onRowUpdated: function(e){
            var d = e.data;
            if(!d) return;
            $.ajax({
                url: '/DKCa/UpdateShift',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ CaLV: d.CaLV, TGBatDau: d.TGBatDau, TGKetThuc: d.TGKetThuc }),
                success: function(resp){
                    if(resp && resp.success === false){
                        showModalAlert(resp.error || 'Không thể cập nhật ca', 'error', 'Lỗi');
                        loadShifts();
                        return;
                    }
                    loadShifts();
                    if(resp && resp.details){
                        details = renderSTT(resp.details);
                        gridDetails.option('dataSource', details);
                    }
                },
                error: function(){ showModalAlert('Lỗi khi lưu ca.', 'error', 'Lỗi'); }
            });
        }
    }).dxDataGrid('instance');

    var selectedCaLV = null;

    // details grid visible always
    $("#gridShiftDetails").show();

    var gridDetails = $("#gridShiftDetails").dxDataGrid({
        dataSource: details,
        showBorders: true,
        height: 360,
        allowColumnResizing: true,
        columnResizingMode: 'widget',
        scrolling: { mode: 'virtual' },
        pager: { visible: false },
        filterRow: { visible: true },
        searchPanel: { visible: true, width: 240 },
        editing: {
            mode: 'cell',
            allowUpdating: true,
            allowDeleting: false
        },
        columnAutoWidth: false,
        columns: [
            { caption: 'STT', dataField: 'STT', width: 80, allowFiltering:false, allowEditing: false, alignment: 'center' },
            { caption: 'TimeShiftID', dataField: 'TimeShiftID', width: 150, allowEditing: false, alignment: 'center' },
            { caption: 'Thời Gian', dataField: 'Name', width: 350, allowEditing: true, alignment: 'center' },
            { caption: 'Số Phút', dataField: 'Minutes', width: 100, allowEditing: false, alignment: 'center' },
           
        ],
        onRowClick: function(e){
            showDetailInfo(e.data);
        },
        onEditingStart: function(e){
            // allow editing first row but we will validate changes later
            return;
        },
        onRowUpdating: function(e){
            // validate Name format HH:MM-HH:MM (24h) and prevent changing start time for STT==1
            var oldName = e.oldData && e.oldData.Name ? e.oldData.Name : null;
            var newName = e.newData && e.newData.Name ? e.newData.Name : oldName;
            var timeRegex = /^([01]?\d|2[0-3]):[0-5]\d-([01]?\d|2[0-3]):[0-5]\d$/;
            if(!timeRegex.test(newName)){
                DevExpress.ui.notify('Định dạng Thời Gian phải là HH:MM-HH:MM (24h), ví dụ 07:30-08:30', 'warning', 4000);
                e.cancel = true;
                return;
            }
            if(e.oldData && e.oldData.STT === 1){
                // split and compare start parts
                var oldParts = oldName.split('-');
                var newParts = newName.split('-');
                if(oldParts[0] !== newParts[0]){
                    // user tried to change start time of first row - disallow
                    DevExpress.ui.notify('Không thể sửa thời gian bắt đầu của dòng đầu tiên.', 'warning', 4000);
                    e.cancel = true;
                    return;
                }
            }
        },
        onRowUpdated: function(e){
            // after cell edit saved, push update to server
            if(!selectedCaLV) return;
            var updated = e.key ? e.key : e.data;
            var timeShiftID = e.data.TimeShiftID;
            var newName = e.data.Name;
            $.ajax({
                url: '/DKCa/UpdateShiftName',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ CaLV: selectedCaLV, TimeShiftID: timeShiftID, NewName: newName }),
                success: function(resp){
                    if(resp && resp.details){
                        details = renderSTT(resp.details);
                        gridDetails.option('dataSource', details);
                    } else {
                        loadShiftDetails(selectedCaLV);
                    }
                },
                error: function(){ alert('Lỗi khi lưu thay đổi.'); }
            });
        }
    }).dxDataGrid('instance');

    // Responsive heights: fill available viewport space
    function resizeGrids(){
        try{
            var topOffset = $('#gridShifts').offset().top;
            var avail = $(window).height() - topOffset - 80; // leave margin
            if(avail < 200) avail = 200;
            gridShifts.option('height', avail);
            gridDetails.option('height', avail);
        }catch(err){}
    }
    $(window).on('resize', resizeGrids);
    // initial call
    setTimeout(resizeGrids, 50);

    function renderSTT(list){
        for(var i=0;i<list.length;i++){ list[i].STT = i+1; }
        return list;
    }

    function loadShifts(){
        $.getJSON('/DKCa/GetShifts')
            .done(function(data){
                shifts = renderSTT(data || []);
                gridShifts.option('dataSource', shifts);
            })
            .fail(function(){
                alert('Không thể tải danh sách ca. Kiểm tra kết nối server.');
            });
    }

    function loadShiftDetails(caLV){
        $.getJSON('/DKCa/GetShiftDetails', { caLV: caLV })
            .done(function(data){
                details = renderSTT(data || []);
                gridDetails.option('dataSource', details);
                $("#detailInfo").hide();
            })
            .fail(function(){
                details = [];
                gridDetails.option('dataSource', details);
                alert('Không thể tải chi tiết ca.');
            });
    }

    function showDetailInfo(item){
        if(!item) return; 
        var html = '<div>stt: ' + (item.STT||'') + '</div>' +
                   '<div>timeShiftID: ' + (item.TimeShiftID||'') + '</div>' +
                   '<div>Thời Gian (Name): ' + (item.Name||'') + '</div>' +
                   '<div>Số Phút (Minutes): ' + (item.Minutes||'') + '</div>';
        $("#detailFields").html(html);
        $("#detailInfo").show();
    }

    $('#btnCreateShift').on('click', function(){
        var CaLV = parseInt($('#inpCaLV').val(),10);
        var TGBatDau = $('#inpTGBatDau').val();
        var TGKetThuc = $('#inpTGKetThuc').val();
        if(!CaLV || !TGBatDau || !TGKetThuc){ alert('Nhập đầy đủ CaLV, TGBatDau và TGKetThuc'); return; }

            $.ajax({
                url: '/DKCa/CreateShift',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ CaLV: CaLV, TGBatDau: TGBatDau, TGKetThuc: TGKetThuc }),
                success: function(resp){
                    if(resp && resp.success === false){
                        alert('Lỗi: ' + (resp.error || 'Không thể tạo ca'));
                        return;
                    }
                    loadShifts();
                    if(resp && resp.details){
                        details = renderSTT(resp.details);
                        gridDetails.option('dataSource', details);
                        $("#gridShiftDetails").show();
                    }
                },
                error: function(xhr){
                    var msg = xhr && xhr.responseText ? xhr.responseText : xhr.statusText;
                    alert('Lỗi khi tạo ca: ' + msg);
                }
            });
    });

    $('#btnRefresh').on('click', function(){ loadShifts(); });

    // initial load
    loadShifts();
});
