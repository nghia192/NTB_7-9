function clearLangForm() {
    $('#txtNewLangCode').val('').prop('readonly', false);
    $('#txtNewLangName').val('');
    $('#txtNewNativeName').val('');
    $('#txtNewFlagIcon').val('');

    $('#txtNewLangCode').focus();
