let languageList = [];
let pendingSaveItems = null; // used when user confirms overwrite

// ============================================================
// Helper: chuẩn hoá kết quả trả về từ các API gọi SP_SYS_LanguageResource
// Backend có thể trả về:
//   - string thuần: 'True' / 'EXISTS' / 'False'
//   - mảng object: [{ Result: 'True'|'EXISTS'|'False', Message: '...' }]
// Hàm này gom về 1 định dạng duy nhất để toàn bộ code dùng chung.
// ============================================================
function parseSpResult(result) {
    if (result === true || result === 'True') {
        return { ok: true, exists: false, message: '' };
    }
    if (result === 'EXISTS') {
        return { ok: false, exists: true, message: '' };
    }
    if (result === false || result === 'False') {
        return { ok: false, exists: false, message: '' };
    }
    if (Array.isArray(result) && result.length > 0) {
        var r = result[0] || {};
        var resVal = r.Result;
        return {
            ok: resVal === 'True' || resVal === true,
            exists: resVal === 'EXISTS',
            message: r.Message || ''
        };
    }
    // Trường hợp Controller trả về 1 OBJECT ĐƠN (không bọc trong mảng),
    // ví dụ { Result: 'True', Message: '' }. Đây là nguyên nhân gây lỗi
    // "Lưu thất bại!" dù dữ liệu đã lưu thành công trong DB, vì trước đây
    // hàm này chỉ nhận dạng mảng, không nhận dạng object đơn.
    if (result && typeof result === 'object' && Object.prototype.hasOwnProperty.call(result, 'Result')) {
        var resVal2 = result.Result;
        return {
            ok: resVal2 === 'True' || resVal2 === true,
            exists: resVal2 === 'EXISTS',
            message: result.Message || ''
        };
    }
    return { ok: false, exists: false, message: 'Không xác định được kết quả trả về.' };
}

// ============================================================
// Helper: gọi API rồi parse JSON, kiểm tra HTTP status trước
// ============================================================
async function callApi(url, options) {
    const response = await fetch(url, options);
    if (!response.ok) {
        throw new Error('HTTP ' + response.status + ' - ' + response.statusText);
    }
    return response.json();
}

// Helper to preserve cell widths when dragging table rows/headers
function fixHelperTable(e, ui) {
    ui.children().each(function () {
        $(this).width($(this).width());
    });
    return ui;
}

// ============================================================
// ĐÃ THÊM: Modal xác nhận tùy chỉnh thay cho window.confirm() mặc định
// của trình duyệt (giao diện "localhost:xxxx cho biết..." xấu, không
// style được, không đồng bộ với giao diện chung của trang).
//
// showConfirmModal(message, options) trả về 1 Promise<boolean>:
//   - resolve(true)  khi người dùng bấm "Đồng ý"
//   - resolve(false) khi người dùng bấm "Huỷ" / bấm X / bấm ra ngoài
//
// options (tất cả optional):
//   title:    tiêu đề modal (mặc định "Xác nhận")
//   okText:   chữ trên nút xác nhận (mặc định "Đồng ý")
//   cancelText: chữ trên nút huỷ (mặc định "Huỷ")
//   variant:  'warning' (mặc định, màu vàng cam - dùng cho ghi đè,
//             cảnh báo) hoặc 'danger' (màu đỏ - dùng cho xóa)
//
// Yêu cầu: đã nhúng #modalConfirmGeneric (xem confirm-modal-snippet.html)
// vào trang.
// ============================================================
function showConfirmModal(message, options) {
    options = options || {};
    var title = options.title || 'Xác nhận';
    var okText = options.okText || 'Đồng ý';
    var cancelText = options.cancelText || 'Huỷ';
    var variant = options.variant || 'warning';

    var $modal = $('#modalConfirmGeneric');
    if ($modal.length === 0) {
        // Fallback an toàn: nếu quên nhúng modal vào trang, vẫn hoạt động
        // được bằng confirm() gốc thay vì crash toàn bộ chức năng.
        console.warn('showConfirmModal: #modalConfirmGeneric không tồn tại trong DOM, dùng confirm() dự phòng.');
        return Promise.resolve(confirm(message));
    }

    $('#confirmTitle').text(title);
    $('#confirmMessage').text(message);
    $('#btnConfirmOk').text(okText);
    $('#btnConfirmCancel').text(cancelText);

    var $iconWrap = $('#confirmIconWrap');
    var $icon = $('#confirmIcon');
    var $btnOk = $('#btnConfirmOk');
    if (variant === 'danger') {
        $iconWrap.css('background', '#fdecea');
        $icon.attr('class', 'fas fa-trash').css('color', '#e5484d');
        $btnOk.css('background', '#e5484d');
    } else {
        $iconWrap.css('background', '#fff7e6');
        $icon.attr('class', 'fas fa-triangle-exclamation').css('color', '#f5a623');
        $btnOk.css('background', '#f5a623');
    }

    return new Promise(function (resolve) {
        var resolved = false;
        function finish(result) {
            if (resolved) return;
            resolved = true;
            $btnOk.off('click.confirmModal');
            $modal.off('hidden.bs.modal.confirmModal');
            resolve(result);
        }
        $btnOk.off('click.confirmModal').on('click.confirmModal', function () {
            $modal.modal('hide');
            finish(true);
        });
        $modal.off('hidden.bs.modal.confirmModal').on('hidden.bs.modal.confirmModal', function () {
            finish(false);
        });
        $modal.modal('show');
    });
}

// ============================================================
// Helper: reorder mảng languageList trong bộ nhớ theo 1 mảng LanguageID mới
// Dùng chung cho mọi nơi kéo-thả ngôn ngữ (input panel, header cột, modal)
// để UI phản hồi ngay lập tức, không cần chờ gọi API xong.
// ============================================================
function reorderLanguageListLocal(newOrder) {
    if (!Array.isArray(newOrder) || !languageList || languageList.length === 0) return;
    var map = {};
    languageList.forEach(function (l) { map[l.LanguageID] = l; });
    var reordered = [];
    newOrder.forEach(function (id) { if (map[id]) reordered.push(map[id]); });
    // append any missing languages that were not in newOrder
    languageList.forEach(function (l) { if (!newOrder.includes(l.LanguageID)) reordered.push(l); });
    languageList = reordered;
}

