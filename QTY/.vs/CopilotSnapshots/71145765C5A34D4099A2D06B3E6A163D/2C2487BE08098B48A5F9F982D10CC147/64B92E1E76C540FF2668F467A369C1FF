}

// Lưu resource — gửi tất cả ngôn ngữ cùng lúc
async function saveResource() {
    const key = $('#txtResourceKey').val().trim();

    if (!key) {
        showToast('warning', 'Vui lòng nhập Resource Key!');
        $('#txtResourceKey').focus();
        return;
    }

    // Thu thập tất cả bản dịch
    var items = [];
    $('.lang-input').each(function () {
        var val = $(this).val().trim();
        if (val) {
            items.push({
                ResourceKey: key,
                LanguageID: $(this).data('lang'),
                Value: val,
                Description: '',
                IsHtml: false,
                UpdatedBy: 'admin'
            });
        }
    });

    if (items.length === 0) {
        showToast('warning', 'Vui lòng nhập ít nhất một bản dịch!');
        return;
    }

    try {
        // Check duplicates first
        const chk = await callApi('/api/SYS_Language/CheckResourceExists', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(items)
        });

        if (chk && chk.length > 0) {
            // There are existing translations for some ResourceKey/Language combinations
            // Populate overwrite modal with existing items so user can review before forcing overwrite
            pendingSaveItems = items; // store for confirmation
            var $tb = $('#tblOverwriteList tbody');
            $tb.empty();
            try {
                (chk || []).forEach(function (row) {
                    var tr = '<tr><td>' + escapeHtml(row.ResourceKey || '') + '</td><td>' + escapeHtml(row.LanguageID || '') + '</td><td>' + escapeHtml(row.CurrentValue || '') + '</td></tr>';
                    $tb.append(tr);
                });
            } catch (e) { console.error('populate overwrite list', e); }
            $('#modalOverwriteConfirm').modal('show');
        } else {
            // No duplicates -> save normally
            const result = await callApi('/api/SYS_Language/Save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(items)
            });
            const r = parseSpResult(result);

            if (r.ok) {
                showToast('success', 'Lưu thành công (' + items.length + ' ngôn ngữ)!');
                clearForm();
                loadResources();
                $('#txtResourceKey').focus();
            } else if (r.exists) {
                // Should not normally happen because we checked, but handle defensively
                const okOverwriteRes = await showConfirmModal(
                    r.message || 'Một hoặc nhiều bản dịch đã tồn tại. Bạn có muốn ghi đè không?',
                    { title: 'Bản dịch đã tồn tại', okText: 'Ghi đè', variant: 'warning' }
                );
                if (okOverwriteRes) {
                    const result2 = await callApi('/api/SYS_Language/Save?allowOverwrite=true', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(items)
                    });
                    const r2 = parseSpResult(result2);
                    if (r2.ok) {
                        showToast('success', 'Lưu thành công!');
                        clearForm();
                        loadResources();
                        $('#txtResourceKey').focus();
                    } else {
                        showToast('error', r2.message || 'Lưu thất bại!');
                    }
                }
            } else {
                showToast('error', r.message || 'Lưu thất bại!');
            }
        }
    } catch (ex) {
        showToast('error', 'Lỗi kết nối: ' + ex.message);
    }
}

