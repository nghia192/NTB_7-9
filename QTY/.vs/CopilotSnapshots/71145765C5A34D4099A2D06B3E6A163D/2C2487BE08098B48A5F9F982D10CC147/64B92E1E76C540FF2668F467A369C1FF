// ============================================================
function initResourceTableSortable($body) {
    try {
        if (!($body && $body.length && $.ui && $.ui.sortable)) return;
        if ($body.data('ui-sortable')) {
            $body.sortable('destroy');
        }
        $body.sortable({
            axis: 'y',
            helper: fixHelperTable,
            cancel: 'button, input, textarea, .no-drag',
            placeholder: 'ui-state-highlight',
            start: function () { $('body').addClass('lang-dragging'); },
            stop: function () { $('body').removeClass('lang-dragging'); },
            update: function () { saveResourceOrderFromTable($body); }
        }).disableSelection();
    } catch (e) { console.warn('init resource tbody sortable failed', e); }
}

function saveLangOrderFromModal() {
