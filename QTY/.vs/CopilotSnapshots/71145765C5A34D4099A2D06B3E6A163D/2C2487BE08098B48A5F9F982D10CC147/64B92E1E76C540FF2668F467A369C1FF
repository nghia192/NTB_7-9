// Delegated handlers for dynamic buttons (ensure they always work)
$(function () {
    // Edit language in modal
    $(document).on('click', '#langListBody .btn-edit-lang', function () {
        var $tr = $(this).closest('tr');
        var lang = $tr.data('lang');
        if (!lang) return;
        // find language object
        var obj = (languageList || []).find(function (l) { return l.LanguageID === lang; }) || {};
        $('#txtNewLangCode').val(obj.LanguageID || '').prop('readonly', true);
        $('#txtNewLangName').val(obj.LanguageName || '');
        $('#txtNewNativeName').val(obj.NativeName || '');
        $('#txtNewFlagIcon').val(obj.FlagIcon ? obj.FlagIcon.toLowerCase() : '').trigger('change.select2');

        $('#txtNewLangName').focus();
    });

    // Delete language in modal
    $(document).on('click', '#langListBody .btn-del-lang-confirm', async function () {
        var $tr = $(this).closest('tr');
        var lang = $tr.data('lang');
        var name = $tr.find('.edit-lang-name').text() || lang;
        if (!lang) return;
        var okDelLang = await showConfirmModal(
            'Xóa ngôn ngữ "' + name + '" (' + lang + ')?\nTất cả bản dịch của ngôn ngữ này cũng sẽ bị xóa!',
            { title: 'Xóa ngôn ngữ', okText: 'Xóa', variant: 'danger' }
        );
        if (!okDelLang) return;
        try {
            var result = await callApi('/api/SYS_Language/DeleteLanguage?langCode=' + encodeURIComponent(lang), { method: 'POST' });
            var r = parseSpResult(result);
            if (r.ok) {
                showToast('success', 'Đã xóa ngôn ngữ "' + name + '"!');
                loadLangList();
                await loadLanguages();
                loadResources();
            } else {
                console.warn('DeleteLanguage failed', result);
                showToast('error', r.message || 'Xóa thất bại!');
            }
        } catch (ex) {
            showToast('error', 'Lỗi: ' + ex.message);
        }
    });

    // Edit resource row -> populate inputs
    $(document).on('click', '#tblBody .btn-edit', function () {
        var $tr = $(this).closest('tr');
        var key = $tr.find('td').eq(1).text().trim();
        if (!key) return;
        $('#txtResourceKey').val(key);
        $('.lang-input').each(function () {
            var lang = $(this).data('lang');
            var cell = $tr.find('td.lang-cell[data-lang="' + lang + '"]');
            var val = cell.find('.lang-value').text() || '';
            $(this).val(val);
        });
        $('#txtResourceKey').focus();
    });

    // Delete single translation in a row
    $(document).on('click', '#tblBody .btn-del-lang', async function () {
        var $btn = $(this);
        var $td = $btn.closest('td.lang-cell');
        var langID = $td.data('lang');
        var $tr = $btn.closest('tr');
        var resourceKey = $tr.find('td').eq(1).text().trim();
        if (!resourceKey || !langID) return;
        var okDelTrans = await showConfirmModal(
            'Xóa bản dịch "' + resourceKey + '" (' + langID + ')?',
            { title: 'Xóa bản dịch', okText: 'Xóa', variant: 'danger' }
        );
        if (!okDelTrans) return;
        try {
            var result = await callApi('/api/SYS_Language/Delete?resourceKey=' + encodeURIComponent(resourceKey) + '&languageID=' + encodeURIComponent(langID), { method: 'POST' });
            var r = parseSpResult(result);
            if (r.ok) {
                showToast('success', 'Xóa bản dịch ' + langID + ' thành công!');
                loadResources();
            } else {
                console.warn('Delete resource failed', result);
                showToast('error', r.message || 'Xóa thất bại!');
            }
        } catch (ex) {
            showToast('error', 'Lỗi: ' + ex.message);
        }
    });

    // Delete whole key
    $(document).on('click', '#tblBody .btn-delete', async function () {
        var $tr = $(this).closest('tr');
        var resourceKey = $tr.find('td').eq(1).text().trim();
        if (!resourceKey) return;
        var okDelKey = await showConfirmModal(
            'Xóa toàn bộ bản dịch của "' + resourceKey + '"?',
            { title: 'Xóa từ khóa', okText: 'Xóa', variant: 'danger' }
        );
        if (!okDelKey) return;
        try {
            var result = await callApi('/api/SYS_Language/Get?action=DELETE_BY_KEY&para1=' + encodeURIComponent(resourceKey));
            var r = parseSpResult(result);
            if (r.ok) {
                showToast('success', 'Xóa thành công!');
                loadResources();
            } else {
                showToast('error', r.message || 'Xóa thất bại!');
            }
        } catch (ex) {
            showToast('error', 'Lỗi: ' + ex.message);
        }
    });

});

$(function () {
    // Load ngôn ngữ trước, sau đó mới load dữ liệu
    loadLanguages().then(function () {
        loadResources();
    });

    // Sự kiện Enter ở ô Resource Key
    $('#txtResourceKey').on('keypress', function (e) {
        if (e.which === 13) loadResourceByKey($(this).val().trim());
    });

    // Sự kiện nút Lưu
    $('#btnSave').on('click', saveResource);

    // Sự kiện Làm mới
    $('#btnClear').on('click', clearForm);

    // Sự kiện Tra cứu
    $('#btnSearch').on('click', function () { loadResources(); });
    $('#btnRefresh').on('click', function () { $('#txtSearch').val(''); loadResources(); });
    $('#txtSearch').on('keypress', function (e) {
        if (e.which === 13) loadResources();
    });

    $('#btnAddLangGlobal').on('click', function () {
        clearLangForm();
        $('#modalAddLang').modal('show');
    });

    // Chỉ load danh sách + khởi tạo sortable SAU KHI modal đã hiện
    // hoàn toàn, đảm bảo jQuery UI Sortable đo được kích thước thật.
    $('#modalAddLang').on('shown.bs.modal', function () {
        loadLangList();
    });

    $('#btnSaveNewLang').on('click', async function () {
    var code = $('#txtNewLangCode').val().trim();
    var name = $('#txtNewLangName').val().trim();
    var native = $('#txtNewNativeName').val().trim();

    // Thêm dòng này để lấy giá trị cờ
    var flag = $('#txtNewFlagIcon').val() || ''; 

    if (!code) { showToast('warning', 'Vui lòng nhập mã ngôn ngữ!'); return; }
    if (!name) { showToast('warning', 'Vui lòng nhập tên ngôn ngữ!'); return; }

    // Thay thế biến url bằng đoạn mới nối thêm tham số flagIcon
    var url = '/api/SYS_Language/SaveLanguage?langCode=' + encodeURIComponent(code) 
            + '&langName=' + encodeURIComponent(name) 
            + '&nativeName=' + encodeURIComponent(native) 
            + '&flagIcon=' + encodeURIComponent(flag);

        try {
            // Lần gọi đầu: không cho ghi đè
            var result = await callApi(url, { method: 'POST' });
            var r = parseSpResult(result);

            if (r.ok) {
                showToast('success', 'Đã lưu ngôn ngữ "' + name + '"!');
                clearLangForm();
                await loadLanguages();
                loadLangList();

                loadResources();
                return;
            }

            if (r.exists) {
                // Dùng Message chi tiết từ SP (phân biệt trùng LanguageID / LanguageName / NativeName)
                var confirmMsg = r.message || ('Ngôn ngữ "' + code + '" đã tồn tại. Bạn có muốn cập nhật thông tin?');
                var okOverwriteLang = await showConfirmModal(confirmMsg, {
                    title: 'Ngôn ngữ đã tồn tại',
                    okText: 'Ghi đè',
                    variant: 'warning'
                });
                if (!okOverwriteLang) return;

                var result2 = await callApi(url + '&allowOverwrite=true', { method: 'POST' });
                var r2 = parseSpResult(result2);
                if (r2.ok) {
                    showToast('success', 'Đã cập nhật ngôn ngữ "' + name + '"!');
                    clearLangForm();
                    await loadLanguages();
                    loadLangList();
                    loadResources();
                } else {
                    showToast('error', r2.message || 'Lưu thất bại!');
                }
                return;
            }

            // Result = False -> có lỗi thật sự (VD trùng LanguageName/NativeName với ngôn ngữ khác)
            showToast('error', r.message || 'Lưu thất bại!');
        } catch (ex) {
            showToast('error', 'Lỗi: ' + ex.message);
        }
    });

    $('#btnClearLangForm').on('click', clearLangForm);

    // Overwrite modal confirm button (dành cho resource, không phải language)
    $('#btnOverwriteConfirm').on('click', async function () {
        if (!pendingSaveItems || !Array.isArray(pendingSaveItems) || pendingSaveItems.length === 0) {
            $('#modalOverwriteConfirm').modal('hide');
            return;
        }
        try {
            const result = await callApi('/api/SYS_Language/Save?allowOverwrite=true', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(pendingSaveItems)
            });
            const r = parseSpResult(result);
            if (r.ok) {
                showToast('success', 'Ghi đè và lưu thành công!');
                clearForm();
                loadResources();
                $('#txtResourceKey').focus();
            } else {
                showToast('error', r.message || 'Ghi đè thất bại!');
            }
        } catch (ex) {
            showToast('error', 'Lỗi: ' + ex.message);
        } finally {
            pendingSaveItems = null;
            $('#modalOverwriteConfirm').modal('hide');
        }
    });

    $('#txtLangFilter').on('keyup', function () {
        loadLangList();
    });
});

// ============================================================
// Load danh sách ngôn ngữ trong modal
// ============================================================
function loadLangList() {
    var keyword = ($('#txtLangFilter').val() || '').trim().toLowerCase();
    var filtered = languageList.filter(function (l) {
        if (!keyword) return true;
        return (l.LanguageID || '').toLowerCase().indexOf(keyword) >= 0
            || (l.LanguageName || '').toLowerCase().indexOf(keyword) >= 0
            || (l.NativeName || '').toLowerCase().indexOf(keyword) >= 0;
    });
    renderLangList(filtered);
}

function renderLangList(langArray) {
    var $body = $('#langListBody');
    $body.empty();
    $('#langCount').text(langArray.length + ' ngôn ngữ');

    // Keep existing order from languageList (server-controlled). Move Vietnamese to top if present.
    langArray.sort(function (a, b) {
        if (a.LanguageID === 'vi-VN') return -1;
        if (b.LanguageID === 'vi-VN') return 1;
        return 0;
    });

    if (langArray.length === 0) {
        $body.append('<tr><td colspan="6" class="text-center text-muted py-3">Không tìm thấy ngôn ngữ nào.</td></tr>');
        return;
    }

    langArray.forEach(function (lang) {
        var isDefault = (lang.LanguageID === 'vi-VN');

        var flagHtml = lang.FlagIcon ? '<span class="fi fi-' + escapeHtml(lang.FlagIcon.toLowerCase()) + '" style="font-size: 18px; border-radius: 2px;"></span>' : '';

        // attach data-lang to the row so sortable can read the language code after reordering
        var $tr = $('<tr data-lang="' + lang.LanguageID + '">' +
            //1
            '<td style="padding:6px 8px;font-size:13px"><code>' + escapeHtml(lang.LanguageID) + '</code></td>' +
            //2
            '<td style="padding:6px 8px;font-size:13px" class="edit-lang-name">' + escapeHtml(lang.LanguageName || '') + '</td>' +
            //3
            '<td style="padding:6px 8px;font-size:13px" class="edit-lang-native">' + escapeHtml(lang.NativeName || '') + '</td>' +
            //4
            '<td style="padding:6px 8px;text-align:center;">' + flagHtml + '</td>' + /* Cột hiển thị cờ */
            //5
            '<td style="padding:6px 8px;font-size:13px;text-align:center">' + (isDefault ? '<span class="badge bg-primary">Mặc định</span>' : '') + '</td>' +
            //6
            '<td style="padding:6px 8px;text-align:center">' +
            '<button class="btn btn-sm btn-outline-primary btn-edit-lang py-0 px-1" title="Sửa"><i class="fas fa-pen" style="font-size:11px"></i></button> ' +
            (!isDefault ? '<button class="btn btn-sm btn-outline-danger btn-del-lang-confirm py-0 px-1" title="Xóa"><i class="fas fa-trash" style="font-size:11px"></i></button>' : '') +
            '</td>' +
            '</tr>');

        // Con trỏ "move" để gợi ý người dùng có thể kéo-thả hàng này,
        // đồng bộ với hành vi của bảng từ khóa (#tblBody).
        $tr.css('cursor', 'move');

        // (các handler click được gắn qua event delegation ở trên, không cần gắn lại ở đây)

        $body.append($tr);
    });

    initLangListSortable($body);
}

function initLangListSortable($body) {
    try {
        if (!($body && $body.length && $.ui && $.ui.sortable)) return;
        if ($body.data('ui-sortable')) {
            $body.sortable('destroy');
        }
        $body.sortable({
            axis: 'y',
            helper: fixHelperTable,
            // Prevent buttons and inputs from starting a drag so clicks still fire
            cancel: 'button, .btn, input, textarea, .no-drag',
            placeholder: 'ui-state-highlight',
            start: function () { $('body').addClass('lang-dragging'); },
            stop: function () { $('body').removeClass('lang-dragging'); },
            update: async function (evt, ui) {
                var order = [];
                $body.find('tr').each(function () { order.push($(this).data('lang')); });

                // Cập nhật UI ngay lập tức, không chờ server phản hồi
                // (đồng bộ hành vi với renderLangInputs() / initColumnSortable())
                reorderLanguageListLocal(order);
                renderPivotHeader();

                try {
                    const result = await callApi('/api/SYS_Language/SaveOrder', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(order)
                    });
                    const r = parseSpResult(result);
                    if (r.ok) {
                        showToast('success', 'Đã lưu thứ tự ngôn ngữ!');
                        await loadLanguages();
                        loadResources();
                    } else {
                        showToast('error', r.message || 'Lưu thứ tự thất bại!');
                    }
                } catch (ex) {
                    console.error('Save lang order error', ex);
                    showToast('error', 'Lỗi khi lưu thứ tự: ' + ex.message);
                }
            }
        }).disableSelection();
    } catch (e) { console.warn('init lang list sortable failed', e); }
}

