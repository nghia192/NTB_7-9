// Dọn dẹp z-index cho các modal chồng lớp
$(document).on('show.bs.modal', '.modal', function (event) {
    var zIndex = 1055 + (10 * $('.modal.show').length);
    $(this).css('z-index', zIndex);

    // Đảm bảo backdrop nằm đúng lớp (dưới modal hiện tại, trên modal cha)
    setTimeout(function () {
        $('.modal-backdrop').not('.modal-stack').css('z-index', zIndex - 1).addClass('modal-stack');
    }, 0);
});

// Khi đóng bất kỳ modal nào, xóa sạch backdrop thừa và khôi phục body
$(document).on('hidden.bs.modal', '.modal', function () {
    // Nếu vẫn còn modal khác đang mở thì giữ lại class modal-open cho body
    if ($('.modal.show').length > 0) {
        $('body').addClass('modal-open');
    } else {
        $('body').removeClass('modal-open');
    }
    // Dọn sạch backdrop cũ
    $('.modal-backdrop').remove();
});