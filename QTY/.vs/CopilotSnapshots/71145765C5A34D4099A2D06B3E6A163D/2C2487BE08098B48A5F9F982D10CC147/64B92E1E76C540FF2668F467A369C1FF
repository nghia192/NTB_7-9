    try {
        if ($.ui && $.ui.sortable) {
            $body.sortable('destroy');
            $body.sortable({
                axis: 'y',
                handle: '.lang-name',
                helper: fixHelperTable,
                start: function () { $('body').addClass('lang-dragging'); },
                stop: function () { $('body').removeClass('lang-dragging'); },
                update: async function (evt, ui) {
                    var order = [];
                    $body.find('tr.lang-row').each(function () { order.push($(this).data('lang')); });
                    // Optimistically reorder languageList locally so UI updates immediately
                    reorderLanguageListLocal(order);
                    renderLangInputs();
                    renderPivotHeader();
                    try {
                        const result = await callApi('/api/SYS_Language/SaveOrder', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(order)
                        });
