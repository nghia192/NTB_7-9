@{
    Layout = null;
    ViewBag.Ver = "1.4";
}


<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width; initial-scale=1.0; maximum-scale=1.0; user-scalable=0;" />
    <title>Cài Đặt CheckList</title>

    <link href="~/css/thuviencss/fontawesome.pro.6.0.0.css" rel="stylesheet" />
    <link href="~/css/thuviencss/roboto.css" rel="stylesheet" />
    <link href="~/css/thuviencss/select2.css" rel="stylesheet" />
    <link href="~/css/thuviencss/toastr.min.css" rel="stylesheet" />
    <link href="~/css/thuviencss/bootstrap5.3.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css"
          rel="stylesheet">
    <style>
        :root {
            --clr-primary: #185FA5;
            --clr-danger: #A32D2D;
            --clr-border: #dee2e6;
            --clr-header-bg: #f8f9fa;
        }

        body {
            background: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
            font-size: 13px;
        }

        .select2-container--default .select2-dropdown {
            border: 1px solid #ced4da;
            min-width: 100px;
            overflow-wrap: break-word;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 26px;
            position: absolute;
            top: 2px;
            right: 1px;
            width: 20px;
        }

        .select2-results__option[aria-selected] {
            cursor: pointer;
            font-size: 13px;
        }

        .txtselected {
            margin-bottom: 2px;
            font-size: 14px;
            font-weight: 600;
        }

        .select2-container .select2-selection--single .select2-selection__rendered {
            font-size: 13px;
            padding-top: 0px;
        }

        .select2-container .select2-selection--single {
            box-sizing: border-box;
            cursor: pointer;
            display: block;
            height: 33px;
            border: 1px solid #ccc !important;
            user-select: none;
            -webkit-user-select: none;
        }
        /* ── Page wrapper ── */
        .page-card {
            background: #fff;
            border-radius: 2px;
            border: 1px solid var(--clr-border);
            padding: 4px 4px;
            margin: 5px 4px;
        }

        /* ── Page title ── */
        .page-title {
            font-size: 15px;
            font-weight: 600;
            color: #1a1a2e;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--clr-border);
        }

            .page-title i {
                color: var(--clr-primary);
                font-size: 18px;
            }

        /* ── Filter bar ── */
        .filter-card {
            background: #fff;
            border-radius: 8px;
            padding: 0px 0px;
            margin-bottom: 10px;
        }

        .filter-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #6c757d;
            margin-bottom: 4px;
        }

        /* ── Buttons ── */
        .btn-tra {
            background: #185FA5;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 0 18px;
            height: 36px;
            font-size: 13px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: background .15s;
        }

            .btn-tra:hover {
                background: #0C447C;
            }

        .btn-bo {
            border: 1px solid #A32D2D;
            border-radius: 6px;
            padding: 0 18px;
            height: 36px;
            font-size: 13px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: background .15s, color .15s;
            background: #A32D2D;
            color: #fff;
        }

            .btn-bo:hover {
                background: #A32D2D;
                color: #fff;
            }

        /* ── Grid header bar ── */
        .grid-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            background: var(--clr-header-bg);
            border: 1px solid var(--clr-border);
            border-bottom: none;
            border-radius: 8px 8px 0 0;
            font-size: 13px;
            font-weight: 500;
            color: #495057;
        }

            .grid-topbar .sel-count {
                background: #e8f0fe;
                color: #185FA5;
                border-radius: 99px;
                font-size: 11px;
                font-weight: 600;
                padding: 2px 10px;
            }

        /* ── DevExtreme overrides ── */
        #gridTraHang {
            border-radius: 0 0 8px 8px;
            border: 1px solid var(--clr-border);
            border-top: none;
            max-height: calc(100vh - 205px);
        }

        .dx-datagrid-headers {
            background: #f1f3f5 !important;
        }

            .dx-datagrid-headers .dx-header-row td {
                font-weight: 600 !important;
                font-size: 13px !important;
            }

        .dx-datagrid-rowsview .dx-row {
            font-size: 13px;
        }

        .dx-datagrid-rowsview .dx-row-alt > td {
            background: #fafbfc;
        }

        /* SL màu khác nhau */
        .sl-diff {
            color: #c0392b;
            font-weight: 600;
        }

        .sl-match {
            color: #27ae60;
            font-weight: 500;
        }

        /* ── Footer summary ── */
        .grid-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            border: 1px solid var(--clr-border);
            border-top: none;
            border-radius: 0 0 8px 8px;
            background: #f8f9fa;
            font-size: 12px;
            color: #6c757d;
        }

            .grid-footer strong {
                color: #185FA5;
            }

        /* Select2 height fix */
        .select2-container--bootstrap-5 .select2-selection {
            height: 36px !important;
            font-size: 13px !important;
        }

        .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
            line-height: 34px !important;
        }

        /* Toast */
        .toast-custom {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            padding: 10px 22px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            color: #fff;
            opacity: 0;
            pointer-events: none;
            transition: opacity .3s;
            z-index: 9999;
            white-space: nowrap;
        }

            .toast-custom.show {
                opacity: 1;
            }

        .dx-header-row .col-header {
            background: #5da566;
            color: #fff !important;
            text-align: center !important;
            vertical-align: middle !important
        }

        .dx-data-row .col-header {
            text-align: center !important;
            font-size: 13px !important;
            vertical-align: middle !important
        }

        .dx-data-row .checkboxTD {
            display: flex;
            justify-content: center
        }

        .dx-footer-row .col-header .dx-datagrid-text-content {
            text-align: center !important;
            color: red !important
        }

        .dx-datagrid-summary-item {
            text-align: center !important;
            color: red !important
        }

        .dx-datagrid-filter-row {
            background: #fff !important;
        }
        /* 2. Scrollbar custom */
        ::-webkit-scrollbar {
            height: 8px;
            width: 8px;
        }

        /* Track */
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        /* Handle */
        ::-webkit-scrollbar-thumb {
            background: #888;
        }

            /* Handle on hover */
            ::-webkit-scrollbar-thumb:hover {
                background: #555;
            }

        .title {
            background: #357C97;
            color: #Fff
        }

        .btn-text {
            font-size: 13px;
        }

        @@media (max-width: 768px) {
            .btn-text {
                font-size: 10px;
            }
        }

        @@media (max-width: 576px) {
            .btn-text {
                font-size: 9px;
            }
        }

        /* Select2 nằm trong DataGrid / Modal cần z-index cao hơn overlay */
        .select2-container {
            z-index: 99 !important;
        }

        .khuvuc-row td {
            vertical-align: middle;
        }

        #modalKhuVuc .modal-dialog {
            max-width: 950px;
        }

        .col-header {
            font-weight: 600;
            background: #f1f3f5;
        }

        .btn-icon-only {
            border: none;
            background: transparent;
            cursor: pointer;
        }

        .dx-select2-cell-editor {
            min-width: 100%;
        }

        /* Wrapper để grid không bị kéo full 100% màn hình lớn */
        #gridWrapper {
            width: 100%;
        }

        /* Màn hình càng lớn thì grid càng thu nhỏ lại (không full ngang) */
        /*@@media (min-width: 992px) {
            #gridWrapper {
                width: auto;
                max-width: 850px;
            }
        }

        @@media (min-width: 1200px) {
            #gridWrapper {
                max-width: 750px;
            }
        }


        @@media (min-width: 1600px) {
            #gridWrapper {
                max-width: 780px;
            }
        }*/

        .dx-datagrid-content .dx-datagrid-table .dx-row .dx-command-edit {
            vertical-align: middle;
        }
        /* ========== MODAL THÊM CHUYỀN ========== */
        .modal-line-content {
            border: none;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 20px 45px rgba(15, 42, 87, 0.25);
        }

        .modal-line-header {
            background: linear-gradient(135deg, #16336b 0%, #0f7ea8 100%);
            color: #fff;
            padding: 1rem 1.25rem;
        }

            .modal-line-header .modal-title {
                font-weight: 600;
                font-size: 0.95rem;
                letter-spacing: 0.2px;
            }

        .modal-line-subtitle {
            font-size: 0.7rem;
            color: rgba(255, 255, 255, 0.75);
            margin-top: 2px;
        }

        .modal-icon-badge {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.16);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            flex-shrink: 0;
        }

        .form-label-line {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #5c6b7a;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .form-label-line i {
                color: #0f7ea8;
                font-size: 0.68rem;
            }

        .input-group-line .input-group-text {
            background: #f1f5f9;
            border-right: none;
            color: #0f7ea8;
            border-color: #dbe3ea;
            font-size: 0.8rem;
        }

        .input-group-line .form-control {
            border-left: none;
            border-color: #dbe3ea;
            font-size: 0.82rem;
        }

            .input-group-line .form-control:focus {
                box-shadow: none;
                border-color: #0f7ea8;
            }

        .input-group-line:focus-within .input-group-text {
            border-color: #0f7ea8;
        }

        #selKhuVucThem {
            font-size: 0.82rem;
        }

        .btn-line-primary {
            background: linear-gradient(135deg, #16336b, #0f7ea8);
            border: none;
            color: #fff;
            font-weight: 500;
            padding: 0.45rem 1.1rem;
            border-radius: 8px;
            transition: filter 0.15s ease;
        }

            .btn-line-primary:hover {
                filter: brightness(1.08);
                color: #fff;
            }

        .col-header {
            font-weight: 600;
            background: #f1f3f5;
        }

        .btn-icon-only {
            border: none;
            background: transparent;
            cursor: pointer;
        }

            .btn-icon-only.disabled {
                opacity: 0.4;
                cursor: not-allowed;
                pointer-events: none;
            }

        .dx-datagrid-rowsview .dx-row {
            border-top: 1px solid transparent;
            border-bottom: 1px solid #ccc;
            border-bottom-width: 1px !important;
        }

        .dx-datagrid-content .dx-datagrid-table [class*=column] + [class*=column]:last-child {
            float: none;
            display: none !important;
        }

        .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused):hover > td, .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused):hover > tr > td, .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused) > td, .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused) > tr > td {
            background-color: #cff2f3 !important;
            color: #333;
        }

        .dx-datagrid-rowsview td {
            vertical-align: middle !important;
        }

            .dx-datagrid-rowsview td > div {
                display: flex;
                align-items: center;
                justify-content: center;
                height: 100%;
            }

        .btnSort {
            background: #fd7e14;
            color: white
        }

            .btnSort:hover:not(:disabled) {
                background: #e06c00;
                box-shadow: 0 2px 8px rgba(253, 126, 20, 0.3);
            }

            .btnSort:active:not(:disabled) {
                box-shadow: 0 1px 3px rgba(253, 126, 20, 0.2);
            }

            .btnSort:disabled {
                background: #ccc;
                color: #999;
                cursor: not-allowed;
                opacity: 0.6;
                box-shadow: none;
            }

        .confirmModal {
            --confirm-color-start: #E24B4A;
            --confirm-color-end: #ff6271;
            --confirm-color-icon-bg: #FCEBEB;
            --confirm-color-icon: #E24B4A;
            --confirm-color-hover: #A32D2D;
        }

            .confirmModal.mConfirmtXacNhanKetThucSom {
                --confirm-color-start: #ffa43c;
                --confirm-color-end: #fac66d;
                --confirm-color-icon-bg: #fffbeb;
                --confirm-color-icon: #ffac6d;
                --confirm-color-hover: #92400e;
            }

            .confirmModal .form-control-sm {
                min-height: calc(1.5em + .5rem + calc(var(--bs-border-width) * 2));
                padding: .25rem .5rem;
                font-size: 12px !important;
                border-radius: var(--bs-border-radius-sm);
            }

            .confirmModal .modal-dialog {
                max-width: 360px;
                margin: auto;
            }

            .confirmModal .modal-header {
                background: linear-gradient(135deg, var(--confirm-color-start), var(--confirm-color-end));
                border-radius: 0px;
                font-size: 16px;
                color: white
            }

            .confirmModal .danger {
                background: linear-gradient(135deg, #E24B4A, #ff6271);
            }

            .confirmModal .reset {
                background: linear-gradient(135deg, #24b359, #4ade80)
            }

            .confirmModal .modal-content {
                border-radius: 12px;
                border: none;
                overflow: hidden;
            }

        #confirmModal .modal-icon-wrap {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: var(--confirm-color-icon-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
        }

        .confirmModal .modal-icon-wrap i {
            font-size: 28px;
            color: var(--confirm-color-icon);
        }


        .confirmModal .modal-body {
            padding: 8px 14px 14px;
            text-align: center;
            border-bottom: 1px solid #f0f0f0;
        }

        .confirmModal .modal-title-text {
            margin: 0 0 8px;
            font-size: 15px;
            font-weight: 500;
            color: #1a1a1a;
        }

        .confirmModal .modal-sub-text {
            margin: 0;
            font-size: 13px;
            color: #6c757d;
            line-height: 1.6;
        }

        .confirmModal .modal-footer {
            display: flex;
            gap: 10px;
            padding: 16px 20px;
            border: none;
        }

        .confirmModal .btn-cancel {
            flex: 1;
            padding: 10px 0;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            background: #f8f9fa;
            color: #495057;
            border: 1px solid #dee2e6;
            cursor: pointer;
        }

            .confirmModal .btn-cancel:hover {
                background: #e9ecef;
            }

        .confirmModal .btn-delete {
            background: linear-gradient(135deg, var(--confirm-color-start), var(--confirm-color-end));
            flex: 1;
            padding: 10px 0;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            color: #fff;
            border: none;
            cursor: pointer;
        }

            .confirmModal .btn-delete:hover {
                background: var(--confirm-color-hover);
            }

        .modal-consequence {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            background: #fff8f0;
            border: 1px solid #fed7aa;
            border-radius: 8px;
            padding: 10px 14px;
            margin: 12px 0 0;
            font-size: 13px;
            color: #92400e;
            text-align: left;
        }

            .modal-consequence i {
                font-size: 15px;
                color: #f97316;
                margin-top: 1px;
                flex-shrink: 0;
            }

        .card-img-top {
            width: 100%;
            height: 180px;
            object-fit: cover;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }

        .transition-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .transition-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15) !important;
            }

        .card {
            border-radius: 8px;
        }

        .card-body {
            padding: 1.25rem;
        }

        .card-footer {
            padding: 1rem;
        }

        .btn-danger {
            border-radius: 6px;
            font-weight: 500;
        }

            .btn-danger:hover {
                background-color: #c82333;
                border-color: #bd2130;
            }

        .btn-floating {
            position: fixed;
            bottom: 15px;
            right: 30px;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: linear-gradient(135deg, #185FA5, #0f7ea8);
            color: #fff;
            border: none;
            font-size: 24px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(24, 95, 165, 0.4);
            transition: transform 0.3s, box-shadow 0.3s;
            z-index: 999;
        }

            .btn-floating.btn-floating-cancel {
                bottom: 15px;
                right: 30px;
                background: linear-gradient(135deg, #ff4d4f, #d9363e) !important;
            }

            .btn-floating.btn-floating-edit {
                bottom: 15px;
                right: 30px;
                background: linear-gradient(135deg, #f7971e, #ffb347) !important;
            }

                .btn-floating.btn-floating-edit:hover {
                    background: linear-gradient(135deg, #e08800, #ff9d1f) !important;
                    box-shadow: 0 6px 20px rgba(247, 151, 30, 0.6);
                }

            .btn-floating:hover {
                transform: scale(1.1);
                box-shadow: 0 6px 20px rgba(24, 95, 165, 0.6);
            }

        .card-img-compact {
            width: 100%;
            height: auto;
            aspect-ratio: 2 / 1.3;
            object-fit: cover;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }

        .card-body-compact {
            padding: 0.5rem 0.5rem 0rem 0.5rem;
        }

        .card-footer-compact {
            padding: 0.35rem 0.5rem 0.5rem 0.5rem;
        }
        /* ── Modal chọn nguồn ảnh ── */
        #modalChonNguonAnh .modal-content {
            border: none;
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }

        #modalChonNguonAnh .modal-body {
            padding: 8px !important;
        }

        #modalChonNguonAnh .btn-source {
            border: none;
            background: #fff;
            border-radius: 10px;
            padding: 14px 16px;
            font-size: 14px;
            font-weight: 500;
            color: #1a1a2e;
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            text-align: left;
            transition: background .15s ease;
        }

            #modalChonNguonAnh .btn-source:hover,
            #modalChonNguonAnh .btn-source:active {
                background: #f1f5f9;
            }

            #modalChonNguonAnh .btn-source .icon-wrap {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: #e8f0fe;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                font-size: 16px;
                color: #185FA5;
            }

        #modalChonNguonAnh .source-divider {
            height: 1px;
            background: #eef1f4;
            margin: 0 4px;
        }

        #modalChonNguonAnh .modal-footer {
            padding: 8px !important;
            border-top: 8px solid #f4f6f9 !important;
        }

            #modalChonNguonAnh .modal-footer .btn-cancel-source {
                border: none;
                background: #f1f3f5;
                border-radius: 10px;
                padding: 12px;
                font-size: 14px;
                font-weight: 600;
                color: #495057;
                width: 100%;
                transition: background .15s ease;
            }

                #modalChonNguonAnh .modal-footer .btn-cancel-source:hover {
                    background: #e9ecef;
                }

        .btn-floating {
            position: fixed;
            bottom: 15px;
            right: 30px;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: linear-gradient(135deg, #185FA5, #0f7ea8);
            color: #fff;
            border: none;
            font-size: 24px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(24, 95, 165, 0.4);
            transition: transform 0.3s, box-shadow 0.3s;
            z-index: 999;
        }

            .btn-floating:hover {
                transform: scale(1.1);
                box-shadow: 0 6px 20px rgba(24, 95, 165, 0.6);
            }

        /* Button thêm mới */
        #btnThemMoi {
            right: 30px;
            bottom: 15px;
        }

        /* Button chỉnh sửa */
        #btnChinhSua {
            right: 100px;
            bottom: 15px;
        }

        /* Button lưu */
        #btnLuuChinhSua {
            right: 100px;
            bottom: 15px;
            background: linear-gradient(135deg, #27ae60, #4ade80);
        }

            #btnLuuChinhSua:hover {
                transform: scale(1.1);
                box-shadow: 0 6px 20px rgba(39, 174, 96, 0.6);
            }

        .card.edit-mode {
            border: 2px solid #185FA5 !important;
            background: #f0f7ff;
        }

            .card.edit-mode .card-footer-compact {
                display: flex !important;
                gap: 8px;
            }

        .edit-card-input {
            display: none;
        }

        .edit-mode .edit-card-input {
            display: block !important;
        }

        .edit-mode .card-title-compact {
            display: none;
        }

        #btnXoaNhanh {
            right: 170px;
            bottom: 15px;
            background: linear-gradient(135deg, #ff4d4f, #d9363e) !important;
        }

        #btnXacNhanXoaNhanh {
            right: 100px;
            bottom: 15px;
            background: linear-gradient(135deg, #28a745, #43d66c) !important;
        }

            #btnXacNhanXoaNhanh:hover {
                box-shadow: 0 6px 20px rgba(226, 75, 74, 0.6);
            }

        /* Card ở chế độ chọn xóa nhanh */
        .card.quick-delete-mode {
            cursor: pointer;
            position: relative;
            transition: border-color .15s, background .15s;
        }

        .card.quick-delete-selected {
            border: 2px solid #E24B4A !important;
            background: #fff0f0;
        }

        .quick-delete-checkbox {
            position: absolute;
            top: 6px;
            left: 6px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: rgba(255,255,255,0.85);
            border: 2px solid #adb5bd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: transparent;
            z-index: 5;
            pointer-events: none;
        }

        .card.quick-delete-selected .quick-delete-checkbox {
            background: #E24B4A;
            border-color: #E24B4A;
            color: #fff;
        }
    </style>
</head>

<body>
    <section>
        <div class="title">
            <div style="display: flex; align-items: center; width: 100%;justify-content:space-between">
                <div style="display: flex; justify-content: center; align-items: center; gap: 6px;">
                    <i id="home" style="font-size: 21px; cursor: pointer; margin-right: 7px; color: #fff; margin-top: 2px;" class="fa-sharp fa-solid fa-house"></i>
                    <span style="margin-top: 2px; color: white; font-size: 18px; padding: 4px 8px; font-weight: 700;">Khai Báo CheckList</span>
                </div>

            </div>
        </div>
    </section>
    <div class="row g-2 mt-2 px-2" id="tbody" style="max-height: calc(-76px + 100vh);overflow:auto">
    </div>

    <button class="btn-floating" id="btnThemMoi" title="Thêm CheckList mới">
        <i class="bi bi-plus-circle"></i>
    </button>
    <button class="btn-floating btn-floating-edit" id="btnChinhSua" title="Chỉnh sửa CheckList">
        <i class="bi bi-pencil"></i>
    </button>

    <button class="btn-floating btn-floating-save" id="btnLuuChinhSua" title="Lưu chỉnh sửa" style="display: none;">
        <i class="bi bi-check-lg"></i>
    </button>
    <button class="btn-floating btn-floating-cancel" id="btnDongChinhSua" title="Đóng chỉnh sửa" style="display: none;">
        <i class="fas fa-xmark"></i>
    </button>
    <button class="btn-floating btn-floating-quickdelete" id="btnXoaNhanh" title="Xóa nhanh nhiều CheckList">
        <i class="bi bi-trash3"></i>
    </button>
    <button class="btn-floating btn-floating-save" id="btnXacNhanXoaNhanh" title="Xóa các mục đã chọn" style="display: none;">
        <i class="bi bi-trash3-fill"></i>
    </button>
    <button class="btn-floating btn-floating-cancel" id="btnHuyXoaNhanh" title="Hủy chọn xóa" style="display: none;">
        <i class="fas fa-xmark"></i>
    </button>

    <div class="modal fade" id="modalChonNguonAnh" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 300px;">
            <div class="modal-content">
                <div class="modal-body">
                    <button type="button" class="btn-source" id="btnChupAnh">
                        <span class="icon-wrap"><i class="bi bi-camera-fill"></i></span>
                        Chụp ảnh
                    </button>
                    <div class="source-divider"></div>
                    <button type="button" class="btn-source" id="btnChonThuVien">
                        <span class="icon-wrap"><i class="bi bi-images"></i></span>
                        Chọn từ thư viện
                    </button>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel-source" data-bs-dismiss="modal">Hủy</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade confirmModal" id="confirmModalXoa" tabindex="-1" aria-hidden="true" style="z-index:9999;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <i class="fa-solid fa-trash "></i> <span id="lblTextTitleDelete">Xóa Check List</span>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="modal-icon-wrap">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <!-- Hậu quả -->
                    <p class="modal-sub-text">
                        Bạn có chắc chắn muốn xóa không?
                    </p>
                    <p class="modal-sub-text" style="margin-top: 8px;">
                        Hành động này <strong>không thể hoàn tác.</strong>
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark" style="margin-right:4px;"></i>Hủy
                    </button>
                    <button id="btnXacNhanXoa" type="button" class="btn-delete">
                        <i class="fa-solid fa-trash" style="margin-right:4px;"></i>Xóa
                    </button>
                </div>

            </div>
        </div>
    </div>

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999999">
        <div id="successToast" class="toast" role="alert">
            <div class="toast-header bg-success text-white">
                <i class="fas fa-check-circle me-2"></i>
                <strong class="me-auto">Thành công</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="successMessage"></div>
        </div>
        <div id="errorToast" class="toast" role="alert">
            <div class="toast-header bg-danger text-white">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong class="me-auto">Lỗi</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="errorMessage"></div>
        </div>
        <div id="warningToast" class="toast" role="alert">
            <div class="toast-header bg-warning text-dark">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong class="me-auto">Cảnh báo</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="warningMessage"></div>
        </div>
    </div>
    <script src="~/Scripts/thuvienjs/jquery.js"></script>
    <script src="~/Scripts/thuvienjs/bootstrap5.3.bundle.min.js"></script>
    <script src="~/Scripts/thuvienjs/select2.js"></script>
    <link href="~/DevExtreme/dx.light.css" rel="stylesheet" />
    <link href="~/DevExtreme/dx.common.css" rel="stylesheet" />

    <script src="~/DevExtreme/dx.all.js"></script>
    <script src="~/DevExtreme/knockout-latest.min.js"></script>

    <script src="~/Scripts/ThuVien/Dic_CheckList.js"></script>
</body>
</html>
