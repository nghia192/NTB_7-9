class PhanLoaiBoPhanGrid extends BaseDevExtremeGrid {
    constructor(Container, Datasource, Setting, Appearance, Events) {
        super(Container, Datasource, Setting, Appearance, Events);
    }

    buildDefaultColumns() {
        const self = this;
        self.Columns = [
            {
                caption: "",
                width: 50,
                alignment: "center",
                allowSorting: false,
                allowFiltering: false,
                allowResizing: false,
                allowReordering: false,

                headerCellTemplate: function (header, info) {
                    $("<div>")
                        .dxButton({
                            icon: "refresh",
                            hint: "Reload dữ liệu",
                            stylingMode: "text",
                            elementAttr: {
                                class: "btn-reload-header"
                            },
                            onClick: () => {
                                self.Events.onReload?.();
                            }
                        })
                        .appendTo(header);
                }
            },
            // {
            //     dataField: "Nhom",
            //     caption: "Nhóm",
            //     allowEditing: false,
            //     groupIndex: 0
            // },
            {
                dataField: "Sort",
                caption: "STT",
                allowSorting: false,
                allowEditing: true,
                sortOrder: "asc",
                width: 60
            },
            {
                dataField: "Name",
                caption: "Nhóm lỗi",
                allowEditing: false,
                minWidth: 200
            },
            {
                dataField: "TenBoPhan",
                caption: "Bộ phận",
                allowEditing: false,
                width: 200
            },           
            {
                caption: "",
                width: 80,
                alignment: "center",
                cellTemplate(container, options) {
                    const trangthai = options.data.TrangThai;
                    $("<div>")
                        .dxCheckBox({
                            value: Number(trangthai) >= 1,
                            disabled: trangthai == 2,
                            onValueChanged: (e) => {
                                self.Events?.onChange(options.data, e.value);
                            }
                        })
                        .appendTo(container);         
                }
            }
        ];
        self.ColumnFields = self.Columns
            .filter(col => col.dataField)
            .map(col => col.dataField);
        return self.Columns;
    }
}
