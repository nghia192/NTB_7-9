BaseFoundation.requireClass("BaseDevExtremeGrid");

class PhanLoaiLoiGrid extends BaseDevExtremeGrid {
    constructor(Container, Datasource, Setting, Appearance, Events) {
        super(Container, Datasource, Setting, Appearance, Events);
    }

    buildDefaultColumns() {
        const self = this;
        self.Columns = [            
            {
                dataField: "Sort",
                caption: "STT",
                allowEditing: true,
                sortOrder: "asc",
                width: 60
            },
            {
                dataField: "MaLoiChiTiet",
                caption: "Mã lỗi",
                allowSorting: false,
                allowEditing: false,
                width: 70
            },
            {
                dataField: "TenLoi",
                caption: "Tên Lỗi",
                allowSorting: false,
                allowEditing: true,
                minWidth: 100
            },
        ];
        self.ColumnFields = self.Columns
            .filter(col => col.dataField)
            .map(col => col.dataField);
        return self.Columns;
    }
}
class PhanLoaiModuleGrid extends BaseDevExtremeGrid {
    constructor(Container, Datasource, Setting, Appearance, Events) {
        super(Container, Datasource, Setting, Appearance, Events);
    }

    buildDefaultColumns() {
        const self = this;
        self.Columns = [          
            {
                dataField: "Sort",
                caption: "STT",
                allowSorting: false,
                allowEditing: true,
                sortOrder: "asc",
                width: 60
            },
            {
                dataField: "TenNhomLoi",
                caption: "Công đoạn",
                allowSorting: false,
                allowEditing: true,
                width: 300
            },
            {
                dataField: "CodeNhomLoi",
                caption: "Mã lỗi",
                allowSorting: false,
                allowEditing: true,
                minWidth: 70
            },
        ];
        self.ColumnFields = self.Columns
            .filter(col => col.dataField)
            .map(col => col.dataField);
        return self.Columns;
    }

    getMaxSort() {
        return Math.max(...this.Datasource.map(row => row.Sort || 0));
    }
}
