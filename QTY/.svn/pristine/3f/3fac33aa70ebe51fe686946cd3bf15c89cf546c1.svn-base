            from {
                opacity: 0;
                transform: translateY(28px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ── Logo ── */
        .logo-wrap {
            display: flex;
            justify-content: center;
        }

            .logo-wrap img {
                height: 130px;
                object-fit: contain;
                width: 130px;
            }

        /* ── Heading ── */
        .heading {
            text-align: center;
            margin-bottom: 32px;
        }

            .heading h1 {
