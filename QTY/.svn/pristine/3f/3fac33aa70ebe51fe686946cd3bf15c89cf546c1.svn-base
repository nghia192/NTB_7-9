    <script src="~/Scripts/thuvienjs/jquery.js"></script>
    <script src="~/Scripts/thuvienjs/bootstrap5.3.bundle.min.js"></script>
    <script src="~/Scripts/thuvienjs/toastr.min.js"></script>

    <script>
        $(document).ready(function () {

            toastr.options = {
                closeButton: true, newestOnTop: false, progressBar: true,
                positionClass: "toast-top-right", preventDuplicates: false,
                showDuration: "300", hideDuration: "1000",
                timeOut: "3000", extendedTimeOut: "1000",
                showEasing: "swing", hideEasing: "linear",
                showMethod: "fadeIn", hideMethod: "fadeOut"
            };

            // Toggle password
            $('#toggle-password').click(function () {
                const $pw = $('#password');
                const isPassword = $pw.attr('type') === 'password';
                $pw.attr('type', isPassword ? 'text' : 'password');
                $(this).find('i').toggleClass('fa-eye-slash', !isPassword).toggleClass('fa-eye', !isPassword);
                $(this).find('i').attr('class', isPassword ? 'fas fa-eye' : 'fas fa-eye-slash');
            });

            // Remember password
            if (localStorage.getItem('remember') === 'true') {
                $('#username').val(localStorage.getItem('username'));
                $('#password').val(localStorage.getItem('password'));
                $('#remember').prop('checked', true);
            }

            // Submit
            $('#login-form').submit(function (e) {
                e.preventDefault();

                const username = $('#username').val().trim();
                const password = $('#password').val();

                if (!username || !password) {
                    toastr.warning('Vui lòng nhập đầy đủ thông tin');
                    return;
                }

                const $btn = $('#btn-submit');
                $btn.addClass('loading').find('.btn-text').html('Đang xử lý...');

                localStorage.setItem('username1', username);
                localStorage.setItem('password1', password);

                if ($('#remember').is(':checked')) {
                    localStorage.setItem('remember', 'true');
                    localStorage.setItem('username', username);
                    localStorage.setItem('password', password);
                } else {
                    localStorage.setItem('remember', 'false');
                    localStorage.removeItem('username');
                    localStorage.removeItem('password');
                }

                $.ajax({
                    url: "/api/SYS_Login/Get?para1=" + encodeURIComponent(username) + "&para2=" + encodeURIComponent(password),
                    type: 'GET',
                    success: function (d) {
                        if (d == "true") {
                            window.location.href = "/Home/Dashboard";
                        } else {
                            $btn.removeClass('loading').find('.btn-text').html('<i class="fas fa-arrow-right-to-bracket"></i> Đăng nhập');
                            toastr.error('Tài khoản hoặc mật khẩu không đúng');
                            $('#password').val('').focus();
                        }
                    },
                    error: function () {
                        $btn.removeClass('loading').find('.btn-text').html('<i class="fas fa-arrow-right-to-bracket"></i> Đăng nhập');
                        toastr.error('Không thể kết nối máy chủ, vui lòng thử lại');
                    }
                });
            });
        });
    </script>
</body>
</html>-->


@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>Đăng nhập — PMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/thuviencss/bootstrap5.3.min.css" rel="stylesheet" />
    <link href="~/css/thuviencss/toastr.min.css" rel="stylesheet" />
    <link href="~/css/thuviencss/fontawesome.pro.6.0.0.css" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --primary: #1a56db;
            --primary-dk: #1342b0;
            --primary-glow: rgba(26, 86, 219, .18);
            --bg: #f0f4ff;
            --card: #ffffff;
            --text: #0f1f3d;
            --muted: #7b8ab0;
            --border: #dde3f0;
            --input-bg: #f7f9ff;
            --font: 'Be Vietnam Pro', sans-serif;
        }

        html, body {
            height: 100%;
            font-family: var(--font);
            background: #0a0f1e;
            color: var(--text);
        }

            /* ── Background ── */
            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background: radial-gradient(ellipse 70% 55% at 15% 15%, rgba(26,86,219,.22) 0%, transparent 55%), radial-gradient(ellipse 55% 45% at 88% 80%, rgba(37,99,235,.18) 0%, transparent 50%), radial-gradient(ellipse 40% 40% at 55% 50%, rgba(14,165,233,.08) 0%, transparent 60%);
                pointer-events: none;
                z-index: 0;
            }

            body::after {
                content: '';
                position: fixed;
                inset: 0;
                background-image: radial-gradient(circle, rgba(255,255,255,.035) 1px, transparent 1px);
                background-size: 32px 32px;
                pointer-events: none;
                z-index: 0;
            }

        /* ── Layout ── */
        .page {
            position: relative;
            z-index: 1;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
            background: #3D4C74
