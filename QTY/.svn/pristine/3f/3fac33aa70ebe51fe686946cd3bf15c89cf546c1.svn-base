                accent-color: var(--primary);
                cursor: pointer;
                flex-shrink: 0;
            }

            .remember-row label {
                font-size: 13px;
                font-weight: 500;
                color: #7b8ab0;
                cursor: pointer;
                user-select: none;
            }

        /* ── Submit button ── */
        .btn-login {
            width: 100%;
            height: 48px;
            background: linear-gradient(135deg, #1a56db 0%, #2563eb 100%);
            color: #fff;
            border: none;
            border-radius: 12px;
            font-family: var(--font);
            font-size: 15px;
            font-weight: 700;
            letter-spacing: .01em;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: transform .15s, box-shadow .15s;
            box-shadow: 0 4px 16px rgba(26,86,219,.35);
        }

            .btn-login::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, rgba(255,255,255,.15) 0%, transparent 60%);
                opacity: 0;
                transition: opacity .2s;
            }

            .btn-login:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 24px rgba(26,86,219,.40);
            }

                .btn-login:hover::before {
                    opacity: 1;
                }

            .btn-login:active {
                transform: translateY(0);
                box-shadow: 0 4px 12px rgba(26,86,219,.30);
            }

            .btn-login .btn-text {
                position: relative;
                z-index: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

            /* Loading spinner inside button */
            .btn-login.loading .btn-text::after {
                content: '';
                width: 16px;
                height: 16px;
                border: 2px solid rgba(255,255,255,.4);
                border-top-color: #fff;
                border-radius: 50%;
                animation: spin .6s linear infinite;
            }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .btn-login.loading {
            pointer-events: none;
            opacity: .85;
        }

        /* ── Footer ── */
        .footer {
            text-align: center;
            margin-top: 24px;
            font-size: 12px;
            color: #b0bace;
        }

        /* ── Responsive ── */
        @@media (max-width: 480px) {
            .card {
                padding: 36px 24px 32px;
                border-radius: 20px;
            }

            .heading h1 {
                font-size: 20px;
            }
        }

        .radio-group {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .radio-item {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            height: 40px;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            color: var(--muted);
            background: var(--input-bg);
            transition: all .18s;
            user-select: none;
            padding: 0 10px;
        }

            .radio-item input[type="radio"] {
                accent-color: var(--primary);
                width: 15px;
                height: 15px;
                cursor: pointer;
                flex-shrink: 0;
            }

            .radio-item:has(input:checked) {
                border-color: var(--primary);
                background: var(--primary-glow);
                color: var(--primary);
            }

            .radio-item:hover {
                border-color: var(--primary);
                color: var(--primary);
            }

        /* ── OTP Modal ── */
        .otp-overlay {
            position: fixed;
            inset: 0;
            background: rgba(10, 15, 30, .55);
            backdrop-filter: blur(3px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 999;
            padding: 16px;
        }

            .otp-overlay.show {
                display: flex;
            }

        .otp-card {
            width: 100%;
            max-width: 380px;
            background: #fff;
            border-radius: 22px;
            padding: 32px 28px;
            box-shadow: 0 20px 60px rgba(15, 31, 61, .25);
            text-align: center;
            animation: slideUp .35s cubic-bezier(.22, 1, .36, 1) both;
        }

            .otp-card i.otp-icon {
                font-size: 32px;
                color: var(--primary);
                background: var(--primary-glow);
                width: 64px;
                height: 64px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 16px;
            }

            .otp-card h2 {
                font-size: 18px;
                font-weight: 800;
                color: #0f1f3d;
                margin-bottom: 6px;
            }

            .otp-card p {
                font-size: 13px;
                color: var(--muted);
                margin-bottom: 22px;
                line-height: 1.5;
            }

                .otp-card p b {
                    color: #0f1f3d;
                }

        .otp-inputs {
            display: flex;
            gap: 8px;
            justify-content: center;
            margin-bottom: 18px;
        }

            .otp-inputs input {
                width: 44px;
                height: 52px;
                text-align: center;
                font-size: 20px;
                font-weight: 700;
                border: 1.5px solid var(--border);
                border-radius: 10px;
                background: var(--input-bg);
                color: #0f1f3d;
                outline: none;
                transition: border-color .2s, box-shadow .2s;
            }

                .otp-inputs input:focus {
                    border-color: var(--primary);
                    background: #fff;
                    box-shadow: 0 0 0 4px var(--primary-glow);
                }

        .otp-resend {
            font-size: 12.5px;
            color: var(--muted);
            margin-top: 4px;
        }

            .otp-resend a {
                color: var(--primary);
                font-weight: 600;
                cursor: pointer;
                text-decoration: none;
            }

                .otp-resend a.disabled {
                    color: var(--muted);
                    cursor: default;
                    pointer-events: none;
                }

        .otp-cancel {
            margin-top: 14px;
            font-size: 12.5px;
            color: var(--muted);
            cursor: pointer;
            text-decoration: underline;
        }
    </style>
</head>

<body>
    <div class="page">
        <div class="card">

            <!-- Logo -->
            <div class="logo-wrap">
                <img src="~/img/logoNTB.png" alt="Logo NTB" />
            </div>
            <!-- Heading -->
            <div class="divider"></div>

            <!-- Form -->
            <form id="login-form" autocomplete="off">

                <div class="field">
                    <label for="username">Tài khoản <span>*</span></label>
                    <div class="input-wrap">
                        <i class="fas fa-user icon"></i>
                        <input type="text" id="username" name="username"
                               placeholder="Nhập tài khoản..." autocomplete="username" required>
                    </div>
                </div>

                <div class="field">
                    <label for="password">Mật khẩu <span>*</span></label>
                    <div class="input-wrap">
                        <i class="fas fa-lock icon"></i>
                        <input type="password" id="password" name="password"
                               placeholder="Nhập mật khẩu..." autocomplete="current-password" required>
                        <span class="toggle-pw" id="toggle-password">
                            <i class="fas fa-eye-slash"></i>
                        </span>
                    </div>
                </div>

                <div class="remember-row">
                    <input type="checkbox" id="remember" name="remember">
                    <label for="remember">Nhớ mật khẩu</label>
                </div>

                <div class="radio-group d-none">
                    <label class="radio-item">
                        <input type="radio" name="system" value="1" checked>
                        <span>QLDH</span>
                    </label>
                    <label class="radio-item">
                        <input type="radio" name="system" value="2">
                        <span>QLSX</span>
                    </label>
                    <label class="radio-item d-none">
                        <input type="radio" name="system" value="3">
                        <span>QTY</span>
                    </label>
                </div>

                <button class="btn-login" type="submit" id="btn-submit">
                    <span class="btn-text">
                        <i class="fas fa-arrow-right-to-bracket"></i>
                        Đăng nhập
                    </span>
                </button>

            </form>

            <div class="footer">Production Management System &copy; 2025</div>
        </div>
    </div>

    <!-- OTP Modal -->
    <div class="otp-overlay" id="otp-overlay">
        <div class="otp-card">
            <div class="otp-icon"><i class="fas fa-envelope-open-text"></i></div>
            <h2>Xác thực thiết bị</h2>
            <p>Thiết bị này chưa được tin cậy.<br>Mã OTP đã gửi tới email <b id="otp-email-mask"></b></p>

            <form id="otp-form" autocomplete="off">
                <div class="otp-inputs">
                    <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" data-idx="0">
                    <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" data-idx="1">
                    <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" data-idx="2">
                    <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" data-idx="3">
                    <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" data-idx="4">
                    <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" data-idx="5">
                </div>

                <button class="btn-login" type="submit" id="btn-verify-otp">
                    <span class="btn-text">
                        <i class="fas fa-shield-check"></i>
                        Xác nhận
                    </span>
                </button>

                <div class="otp-resend">
                    Chưa nhận được mã?
                    <a id="otp-resend-link">Gửi lại (<span id="otp-timer">60</span>s)</a>
                </div>
                <div class="otp-cancel" id="otp-cancel">Hủy và đăng nhập lại</div>
            </form>
        </div>
    </div>

    <script src="~/Scripts/thuvienjs/jquery.js"></script>
    <script src="~/Scripts/thuvienjs/bootstrap5.3.bundle.min.js"></script>
    <script src="~/Scripts/thuvienjs/toastr.min.js"></script>

    <script>
        $(document).ready(function () {

            toastr.options = {
                closeButton: true, newestOnTop: false, progressBar: true,
                positionClass: "toast-top-right", preventDuplicates: false,
                showDuration: "300", hideDuration: "1000",
                timeOut: "3000", extendedTimeOut: "1000",
                showEasing: "swing", hideEasing: "linear",
                showMethod: "fadeIn", hideMethod: "fadeOut"
            };

            // ===== 1. Kiểm tra / tạo DeviceID (lưu trong LocalStorage) =====
            function getOrCreateDeviceId() {
                var deviceId = localStorage.getItem('deviceId');
                if (!deviceId) {
                    deviceId = (window.crypto && window.crypto.randomUUID)
                        ? window.crypto.randomUUID()
                        : 'dev-' + Date.now() + '-' + Math.random().toString(36).slice(2);
                    localStorage.setItem('deviceId', deviceId);
                }
                return deviceId;
            }
            var deviceId = getOrCreateDeviceId();
            var currentUsername = ''; // dùng khi verify OTP

            // Toggle password
            $('#toggle-password').click(function () {
                const $pw = $('#password');
                const isPassword = $pw.attr('type') === 'password';
                $pw.attr('type', isPassword ? 'text' : 'password');
                $(this).find('i').attr('class', isPassword ? 'fas fa-eye' : 'fas fa-eye-slash');
            });

            // Remember password
            if (localStorage.getItem('remember') === 'true') {
                $('#username').val(localStorage.getItem('username'));
                $('#password').val(localStorage.getItem('password'));
                $('#remember').prop('checked', true);
            }

            function resetLoginBtn() {
                $('#btn-submit').removeClass('loading')
                    .find('.btn-text').html('<i class="fas fa-arrow-right-to-bracket"></i> Đăng nhập');
            }

            function goDashboard() {
                toastr.success('Đăng nhập thành công');
                setTimeout(function () {
                    window.location.href = "/Home/Dashboard";
                }, 500);
            }

            // ===== 2. Submit đăng nhập (Nhập tài khoản/mật khẩu -> Gửi thông tin lên server) =====
            $('#login-form').submit(function (e) {
                e.preventDefault();

                const username = $('#username').val().trim();
                const password = $('#password').val();

                if (!username || !password) {
                    toastr.warning('Vui lòng nhập đầy đủ thông tin');
                    return;
                }

                currentUsername = username;

                const $btn = $('#btn-submit');
                $btn.addClass('loading').find('.btn-text').html('Đang xử lý...');

                if ($('#remember').is(':checked')) {
                    localStorage.setItem('remember', 'true');
                    localStorage.setItem('username', username);
                    localStorage.setItem('password', password);
                } else {
                    localStorage.setItem('remember', 'false');
                    localStorage.removeItem('username');
                    localStorage.removeItem('password');
                }
                localStorage.setItem('username1', username);
                $.ajax({
                    url: '/api/SYS_Login/Login',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        Username: username,
                        Password: password,
                        DeviceId: deviceId
                    }),
                    success: function (res) {
                        // res: { Status, Message, EmailMask }
                        switch (res.Status) {
                            case 'success':
                                // Kiểm tra thiết bị -> Đã tin cậy -> Đăng nhập thành công
                                goDashboard();
                                break;

                            case 'need_otp':
                                // Chưa tin cậy -> OTP đã được gửi qua email -> hiện modal nhập OTP
                                resetLoginBtn();
                                openOtpModal(res.EmailMask);
                                break;

                            case 'invalid_account':
                                resetLoginBtn();
                                toastr.error(res.Message || 'Tài khoản không tồn tại');
                                $('#username').focus();
                                break;

                            case 'invalid_password':
                                resetLoginBtn();
                                toastr.error(res.Message || 'Sai mật khẩu');
                                $('#password').val('').focus();
                                break;

                            default:
                                resetLoginBtn();
                                toastr.error(res.Message || 'Có lỗi xảy ra, vui lòng thử lại');
                        }
                    },
                    error: function () {
                        resetLoginBtn();
                        toastr.error('Không thể kết nối máy chủ, vui lòng thử lại');
                    }
                });
            });

            // ===== 3. Modal OTP =====
            var resendTimer = null;

            function openOtpModal(emailMask) {
                $('#otp-email-mask').text(emailMask || '');
                $('.otp-digit').val('');
                $('#otp-overlay').addClass('show');
                startResendCountdown();
                setTimeout(function () { $('.otp-digit[data-idx="0"]').focus(); }, 150);
            }

            function closeOtpModal() {
                $('#otp-overlay').removeClass('show');
                clearInterval(resendTimer);
            }

            function startResendCountdown() {
                clearInterval(resendTimer);
                var sec = 60;
                $('#otp-timer').text(sec);
                $('#otp-resend-link').addClass('disabled');
                resendTimer = setInterval(function () {
                    sec--;
                    $('#otp-timer').text(sec);
                    if (sec <= 0) {
                        clearInterval(resendTimer);
                        $('#otp-resend-link').removeClass('disabled').html('Gửi lại mã');
                    }
                }, 1000);
            }

            // Auto-tab giữa 6 ô OTP
            $(document).on('input', '.otp-digit', function () {
                this.value = this.value.replace(/[^0-9]/g, '');
                if (this.value.length === 1) {
                    var next = $(this).parent().find('[data-idx="' + (+$(this).data('idx') + 1) + '"]');
                    if (next.length) next.focus();
                }
            });
            $(document).on('keydown', '.otp-digit', function (e) {
                if (e.key === 'Backspace' && !this.value) {
                    var prev = $(this).parent().find('[data-idx="' + (+$(this).data('idx') - 1) + '"]');
                    if (prev.length) prev.focus();
                }
            });
            // Dán mã OTP 6 số
            $(document).on('paste', '.otp-digit', function (e) {
                var text = (e.originalEvent.clipboardData || window.clipboardData).getData('text').replace(/[^0-9]/g, '');
                if (text.length) {
                    e.preventDefault();
                    $('.otp-digit').each(function (i) {
                        $(this).val(text[i] || '');
                    });
                    $('.otp-digit').last().focus();
                }
            });

            $('#otp-cancel').click(function () {
                closeOtpModal();
            });

            $('#otp-resend-link').click(function () {
                if ($(this).hasClass('disabled') || !currentUsername) return;
                $.ajax({
                    url: '/api/SYS_Login/ResendOtp',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ Username: currentUsername }),
                    success: function (res) {
                        toastr.info(res.Message || 'Đã gửi lại mã OTP');
                        startResendCountdown();
                    },
                    error: function () {
                        toastr.error('Không thể gửi lại mã, vui lòng thử lại');
                    }
                });
            });

            // ===== 4. Xác thực OTP -> Lưu DeviceID vào SYS_TrustedDevice -> Đăng nhập thành công =====
            $('#otp-form').submit(function (e) {
                e.preventDefault();

                var otp = '';
                $('.otp-digit').each(function () { otp += $(this).val(); });

                if (otp.length !== 6) {
                    toastr.warning('Vui lòng nhập đủ 6 số OTP');
                    return;
                }

                const $btn = $('#btn-verify-otp');
                $btn.addClass('loading').find('.btn-text').html('Đang xác thực...');

                $.ajax({
                    url: '/api/SYS_Login/VerifyOtp',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        Username: currentUsername,
                        Otp: otp,
                        DeviceId: deviceId
                    }),
                    success: function (res) {
                        $btn.removeClass('loading').find('.btn-text').html('<i class="fas fa-shield-check"></i> Xác nhận');
                        if (res.Status === 'success') {
                            closeOtpModal();
                            goDashboard();
                        } else if (res.Status === 'otp_expired') {
                            toastr.error(res.Message || 'Mã OTP đã hết hạn');
                            $('.otp-digit').val('');
                            $('.otp-digit[data-idx="0"]').focus();
                        } else {
                            toastr.error(res.Message || 'Mã OTP không đúng');
                            $('.otp-digit').val('');
                            $('.otp-digit[data-idx="0"]').focus();
                        }
                    },
                    error: function () {
                        $btn.removeClass('loading').find('.btn-text').html('<i class="fas fa-shield-check"></i> Xác nhận');
                        toastr.error('Không thể kết nối máy chủ, vui lòng thử lại');
                    }
                });
            });
        });
    </script>
</body>
</html>

