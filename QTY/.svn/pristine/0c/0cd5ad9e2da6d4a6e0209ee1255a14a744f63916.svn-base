html, body {
    height: 100%;
}


.base-dialog .dx-popup-title {
    font-weight: 600;
}

.dialog-primary .dx-popup-title {
    background: #0d6efd;
    color: white;
}

.dialog-success .dx-popup-title {
    background: #198754;
    color: white;
}

.dialog-danger .dx-popup-title {
    background: #dc3545;
    color: white;
}

.dialog-warning .dx-popup-title {
    background: #ffc107;
    color: black;
}

.lookup-popup-no-padding .dx-popup-content {
    padding: 10px !important;
}

.base-tab .dx-tabs-wrapper {
    gap: 8px;
}

.base-tab .dx-tab {
    flex: 0 0 auto;
    min-width: unset;
    width: auto;
    padding: 8px 18px;
    background: #f5f5f5;
    color: #495057;
    font-weight: 600;
    font-size: 14px;
    transition: all .2s ease;
}

.base-tab .dx-tab:hover {
    background: #e9ecef;
    color: #000;
}

.base-tab .dx-tab-selected {
    background: #555;
    color: #fff;
    font-weight: 700;
}

.base-tab .dx-tab-selected .dx-tab-text {
    color: #fff;
    font-weight: 700;
}

.base-tab .dx-tab .dx-tab-text {
    color: inherit;
    font-weight: inherit;
}

#LoaiLoiModuleTab_Content,
#LoaiLoiModuleTab_Content .dx-multiview,
#LoaiLoiModuleTab_Content .dx-multiview-wrapper,
#LoaiLoiModuleTab_Content .dx-multiview-item-container,
#LoaiLoiModuleTab_Content .dx-multiview-item {
    height: 100%;
    min-height: 0;
}